# ==============================================================================
# DJASSA MARKETPLACE — CONFIGURATION D'ENVIRONNEMENT (SANS SECRETS)
# Copier vers .env avant déploiement et renseigner les clés privées côté serveur.
# Architecture officielle autorisée :
#   - Infrastructure : Google Cloud Run, Supabase (PostgreSQL/Auth), Cloudflare, Cloudflare R2
#   - Notifications : Firebase Cloud Messaging (FCM)
#   - Commerce & Cartes : GeniusPay, Google Maps Platform
#   - Intelligence Artificielle : RodiumAI (MiniMax M3.1 Flash, Qwen Image 2.1 Turbo, MiniMax H3 Max Turbo, MiniMax H3)
# ==============================================================================

# --- Serveur & Google Cloud Run ---
PORT=3000
NODE_ENV=development
CLOUD_RUN_SERVICE_URL=

# Secrets cryptographiques obligatoires en production (>= 32 octets aléatoires)
DJASSA_SECURITY_SECRET=
DJASSA_BACKUP_KEY=
DJASSA_BACKUP_HMAC_SECRET=
DJASSA_ADMIN_SECRET_KEY=
DJASSA_PAYMENT_WEBHOOK_SECRET=

# Ne passer à true uniquement derrière un reverse proxy (Cloudflare / Cloud Run)
# qui réécrit explicitement les en-têtes X-Forwarded-For / CF-Connecting-IP
DJASSA_TRUST_PROXY_HEADERS=false

# Origines autorisées pour CORS en production (séparées par des virgules)
ALLOWED_ORIGINS=
ALLOWED_CORS_ORIGINS=

# --- Supabase (Base PostgreSQL, Auth & RLS) ---
SUPABASE_DB_URL=
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clés publiques Supabase autorisées côté client (protégées par RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Bascule d'authentification : legacy (par défaut) ou postgres (après migrations 001..012 + import vérifié)
DJASSA_AUTH_BACKEND=legacy

# --- Paiements GeniusPay (Serveur uniquement) ---
GENIUSPAY_API_KEY=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://api.geniuspay.ci/v1

# --- Intelligence Artificielle RodiumAI (Serveur uniquement) ---
RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_MODEL_FLASH=minimax-m3.1-flash
RODIUMAI_MODEL_IMAGE=qwen-image-2.1-turbo
RODIUMAI_MODEL_MAX_TURBO=minimax-h3-max-turbo
RODIUMAI_MODEL_STANDARD=minimax-h3

# --- Google Maps Platform (Clé serveur protégée + clé front restreinte par domaine) ---
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Stockage Objet Cloudflare R2 & Sécurité Cloudflare (Serveur uniquement) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEPLOY_HOOK=

# --- Notifications Push Firebase Cloud Messaging (FCM uniquement) ---
FCM_PROJECT_ID=
FCM_SERVER_KEY=
PUSH_WEBHOOK_URL=
